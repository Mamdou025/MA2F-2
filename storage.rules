rules_version = '2';

// Règles Firebase Storage.
//
// Historique : aucun fichier storage.rules n'existait dans ce dépôt avant le
// 2026-09-04 (les sauvegardes Excel écrites par les Cloud Functions
// `uploadToCloudStorage`/`manualBackup`/`dailyBackupToGoogleDrive`, voir
// CLAUDE.md "Backups go to Cloud Storage", passent par le SDK Admin, qui
// ignore ces règles — elles n'avaient donc jamais été nécessaires jusqu'ici).
//
// Ce fichier est ajouté en même temps que le correctif des sauvegardes JSON
// restaurables (voir BackupsSection.tsx / types.ts `Backup.storagePath`,
// 2026-09-04) : le JSON complet de chaque sauvegarde est désormais uploadé
// directement depuis le client vers `backups_json/<id>.json`, ce qui EST
// soumis à ces règles. Accès réservé aux admins (même claim `role` que
// `firestore.rules` `isAdmin()`), tout le reste explicitement refusé.
//
// Déploiement : `firebase deploy --only storage` (pas `storage:rules` — Storage,
// contrairement à Firestore, n'a pas de sous-cible "rules" ; `:rules` serait
// interprété comme un nom de cible multi-bucket et échoue avec "Could not
// find rules for the following storage targets: rules"). Nécessite aussi
// d'ajouter la clé "storage" à firebase.json, déjà fait dans ce commit).
service firebase.storage {
  match /b/{bucket}/o {
    match /backups_json/{fileName} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Deny-all par défaut pour tout le reste du bucket.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
