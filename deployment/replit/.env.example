# Currently used by the Express production server. Add values through Replit Secrets.
NODE_ENV=production
PORT=3000

# Transitional frontend settings only. VITE_* values are PUBLIC in the browser bundle.
# Firebase remains active until the replacement backend and account migration are ready.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_GOOGLE_MAPS_API_KEY=

# Future DATABASE_URL and identity-provider secrets must remain server-side.
# Do not add Odoo keys, pilot tokens or database credentials with a VITE_ prefix.
