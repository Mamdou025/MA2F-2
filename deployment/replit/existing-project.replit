# Aquasachets workspace: current MA2F source is in ma2f-next/.
# The previous application remains at the workspace root for recovery.
modules = ["python-3.12", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "MA2F nouvelle version"

[[workflows.workflow]]
name = "MA2F nouvelle version"
author = "user"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd ma2f-next && pnpm dev:replit --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd ma2f-next && pnpm install --frozen-lockfile && pnpm build:replit"]
run = ["sh", "-c", "cd ma2f-next && PORT=5000 pnpm start"]
