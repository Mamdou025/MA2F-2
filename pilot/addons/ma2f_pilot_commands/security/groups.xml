<odoo>
    <record id="group_pilot_writer" model="res.groups">
        <field name="name">MA2F pilot: controlled production</field>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user')), (4, ref('mrp.group_mrp_user'))]"/>
    </record>
    <record id="rule_pilot_operation_owner" model="ir.rule">
        <field name="name">MA2F pilot: own operations in allowed companies</field>
        <field name="model_id" ref="model_ma2f_pilot_operation"/>
        <field name="groups" eval="[(4, ref('group_pilot_writer'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids), ('integration_user_id', '=', user.id)]</field>
    </record>
</odoo>
