<odoo>
    <record id="group_pilot_reader" model="res.groups">
        <field name="name">MA2F pilot: stock read access</field>
    </record>
    <record id="rule_pilot_quant_company" model="ir.rule">
        <field name="name">MA2F pilot: quantities in allowed companies</field>
        <field name="model_id" ref="stock.model_stock_quant"/>
        <field name="groups" eval="[(4, ref('group_pilot_reader'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
